{
  "name": "salesforce-deployment-guard",
  "displayName": "SF Guard",
  "description": "Prevents accidental code overwrites during Salesforce deployments with conflict detection and visual merge tools",
  "version": "0.6.1",
  "publisher": "SubhadeepDev",
  "icon": "images/sf-guard-production-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/CR-Samrat/salesforce-deployment-guard"
  },
  "keywords": [
    "salesforce",
    "deployment",
    "conflict detection",
    "apex",
    "lwc",
    "sfdx",
    "sf",
    "guard",
    "merge",
    "diff",
    "code protection"
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "salesforce-deployment-guard.retrieve",
        "title": "SF Guard: Retrieve from Org",
        "icon": "$(cloud-download)"
      },
      {
        "command": "salesforce-deployment-guard.safeDeploy",
        "title": "SF Guard: Safe Deploy to Org",
        "icon": "$(shield)"
      },
      {
        "command": "salesforce-deployment-guard.viewSyncStatus",
        "title": "SF Guard: View Sync Status",
        "icon": "$(info)"
      },
      {
        "command": "salesforce-deployment-guard.toggleBackup",
        "title": "SF Guard: Enable/Disable Backup for This File",
        "icon": "$(check)"
      },
      {
        "command": "salesforce-deployment-guard.takeBackup",
        "title": "SF Guard: Keep Backup for This File",
        "icon": "$(cloud-download)"
      },
      {
        "command": "salesforce-deployment-guard.compareBackup",
        "title": "SF Guard: Compare with Backup",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "salesforce-deployment-guard.retrieve",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@1"
        },
        {
          "command": "salesforce-deployment-guard.safeDeploy",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@2"
        },
        {
          "command": "salesforce-deployment-guard.toggleBackup",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@3"
        },
        {
          "command": "salesforce-deployment-guard.takeBackup",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@4"
        },
        {
          "command": "salesforce-deployment-guard.compareBackup",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@5"
        }
      ],
      "editor/context": [
        {
          "command": "salesforce-deployment-guard.retrieve",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@1"
        },
        {
          "command": "salesforce-deployment-guard.safeDeploy",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@2"
        },
        {
          "command": "salesforce-deployment-guard.toggleBackup",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@3"
        },
        {
          "command": "salesforce-deployment-guard.takeBackup",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@4"
        },
        {
          "command": "salesforce-deployment-guard.compareBackup",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "salesforce@5"
        }
      ],
      "editor/title": [
        {
          "command": "salesforce-deployment-guard.compareBackup",
          "when": "resourceExtname =~ /\\.(cls|trigger|apex|page|component|cmp|app|evt|intf|auradoc|design|svg|tokens|xml)$/ || (resourceExtname =~ /\\.(js|html|css)$/ && resourcePath =~ /(lwc|aura)/)",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "@salesforce/core": "^8.25.1",
    "jsforce": "^3.10.13"
  }
}
